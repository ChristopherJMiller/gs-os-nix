# Constants live in the image bank above the image (VM.md "Speed"), until it
# is full: these five 7,000-byte strings make a 35 KB image, so four fit above
# it and the fifth, e, is the nursery's, as every constant was before. (Larger
# strings run into a limit older than this: two promoted strings of 12 KB
# joined are E_NOMEM under GC stress -- STATUS.md.)
let
  a = "";
  b = "";
  c = "";
  d = "";
  e = "";
in [ (map builtins.stringLength [ a b c d e ]) (builtins.substring 6995 10 (a + e))
     (builtins.hashString "sha256" e) (builtins.hashString "sha256" d) (a == e) (e == e) ]
