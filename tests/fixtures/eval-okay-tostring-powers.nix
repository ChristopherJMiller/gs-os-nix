# toString of an INT below 2^32 counts each digit down by its power of ten,
# with no divide (VM.md "Speed"): every power's edge, the 32-bit edge, the
# 64-bit loop above it, and signs.
map toString [
  0 1 9 10 11 99 100 101 999 1000 9999 10000 65535 65536 99999 100000
  999999 1000000 9999999 10000000 99999999 100000000 999999999 1000000000
  1000000001 2147483647 2147483648 4000000000 4294967295 4294967296
  10000000000 1234567890123 9223372036854775807
  (-1) (-10) (-65535) (-65536) (-4294967295) (-4294967296) (-4294967297)
  (-9223372036854775807) (-9223372036854775807 - 1)
]
